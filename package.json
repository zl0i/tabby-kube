{
  "name": "tabby-kube",
  "version": "0.4.0",
  "description": "Kubernetes cluster browser for Tabby: pods, workloads and other resources, shells and logs in terminal tabs",
  "keywords": [
    "tabby-plugin"
  ],
  "homepage": "https://github.com/zl0i/tabby-kube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zl0i/tabby-kube.git"
  },
  "bugs": {
    "url": "https://github.com/zl0i/tabby-kube/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "cross-env TABBY_DEV=1 webpack --progress --color --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext ts src test",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "zl0i",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^15",
    "@angular/compiler": "^15",
    "@angular/compiler-cli": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "@biesbjerg/ngx-translate-extract-marker": "^1",
    "@kubernetes/client-node": "^2.0.0",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "@ngtools/webpack": "^15",
    "@ngx-translate/core": "^14",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "ansi-colors": "^4.1.3",
    "apply-loader": "2.0.0",
    "cross-env": "^7",
    "css-loader": "^6",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "js-yaml": "^5.4.3",
    "jsonpath-plus": "^10.4.0",
    "pug": "3",
    "pug-loader": "^2",
    "rxjs": "^7",
    "sass": "^1",
    "sass-loader": "^13",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "tslib": "^2",
    "typescript": "~4.9.5",
    "webpack": "^5",
    "webpack-cli": "^5",
    "ws": "^8.22.0"
  }
}
