.header
    .context.me-3
        i.fas.fa-dharmachakra.me-2
        strong {{cluster?.contextName ?? profile.name}}
        span.version.ms-2(*ngIf='version') {{version}}

    ng-container(*ngIf='cluster')
        select.form-select.form-select-sm.namespace(
            *ngIf='namespaces !== null',
            [disabled]='!kind.namespaced',
            [ngModel]='namespace',
            (ngModelChange)='selectNamespace($event)'
        )
            option(value='', translate) All namespaces
            option(*ngIf='namespace && !namespaces.includes(namespace)', [value]='namespace') {{namespace}}
            option(*ngFor='let ns of namespaces', [value]='ns') {{ns}}
        input.form-control.form-control-sm.namespace(
            *ngIf='namespaces === null',
            type='text',
            placeholder='Namespace',
            [disabled]='!kind.namespaced',
            [ngModel]='namespace',
            (change)='selectNamespace($any($event.target).value)'
        )

        .input-group.input-group-sm.filter.ms-2
            input.form-control(
                #filterInput,
                type='text',
                placeholder='Filter...  ( / )',
                [(ngModel)]='filterText',
                (input)='onFilterChange()',
                (keydown.escape)='clearFilter()'
            )
            button.btn.btn-secondary(*ngIf='filterText', (click)='clearFilter()')
                i.fas.fa-times

    .flex-grow-1
    .count.me-2(*ngIf='cluster && !loading')
        span(*ngIf='rows.length !== totalCount') {{rows.length}} of&nbsp;
        span {{totalCount}}

.alert.alert-danger.d-flex.align-items-center.m-3(*ngIf='error')
    .me-auto {{error}}
    button.btn.btn-secondary.ms-3((click)='connect()', translate) Retry
.m-3(*ngIf='connecting', translate) Connecting

.main(*ngIf='cluster')
    .sidebar
        ng-container(*ngFor='let section of sections')
            .section-title {{section.title}}
            a.kind(
                *ngFor='let k of section.kinds',
                [class.active]='view === "resources" && k === kind',
                (click)='selectKind(k)'
            ) {{k.title}}
            a.kind(
                *ngIf='section.title === "Network"',
                [class.active]='view === "port-forwards"',
                (click)='showPortForwards()'
            )
                span(translate) Port forwards
                span.badge.bg-secondary.ms-2(*ngIf='portForwards.forwards.length') {{portForwards.forwards.length}}

        ng-container(*ngIf='customGroups.length')
            .section-title Custom resources
            ng-container(*ngFor='let g of customGroups')
                a.group((click)='toggleGroup(g)', [title]='g.group')
                    i.fas.fa-fw.me-1([class.fa-caret-right]='!g.expanded', [class.fa-caret-down]='g.expanded')
                    span {{g.group}}
                ng-container(*ngIf='g.expanded')
                    a.kind.nested(
                        *ngFor='let k of g.kinds',
                        [class.active]='view === "resources" && k === kind',
                        (click)='selectKind(k)'
                    ) {{k.title}}

    .content(*ngIf='view === "port-forwards"')
        .table-wrap
            table.table.table-sm.forwards(*ngIf='portForwards.forwards.length')
                thead
                    tr
                        th(translate) Local address
                        th.wide(translate) Target
                        th(translate) Context
                        th(translate) Connections
                        th
                tbody
                    tr(*ngFor='let f of portForwards.forwards')
                        td
                            a.address((click)='openForward(f)', title='Open in the browser') {{forwardAddress(f)}}
                        td.wide([title]='f.error ?? ""')
                            span {{f.target.kind.kind}}/{{f.target.name}}:{{f.target.port}}
                            span.text-muted.ms-2 {{f.target.namespace}}
                            .forward-error(*ngIf='f.error') {{f.error}}
                        td {{f.contextName}}
                        td {{f.connections}}
                        td.actions
                            button.btn.btn-link.btn-sm((click)='copyForward(f)', title='Copy the address')
                                i.far.fa-copy
                            button.btn.btn-link.btn-sm((click)='stopForward(f)', title='Stop')
                                i.fas.fa-stop
            .text-muted.text-center.mt-4(*ngIf='!portForwards.forwards.length')
                div(translate) No ports are forwarded.
                small(translate) Right-click a pod, service or workload and choose "Port forward…".

    .content(*ngIf='view === "resources"')
        .alert.alert-warning.mx-3.mt-2.mb-0(*ngIf='watchError') {{watchError}}
        .m-3(*ngIf='loading && !watchError', translate) Loading
        .table-wrap(*ngIf='!loading', #tableWrap)
            table.table.table-sm.table-hover
                thead
                    tr
                        th(
                            *ngFor='let column of columns',
                            [class.wide]='column.wide',
                            (click)='sortBy(column)'
                        )
                            span {{column.title}}
                            i.ms-1([class]='sortIcon(column)')
                tbody
                    tr(
                        *ngFor='let row of rows; trackBy: trackRow',
                        [class.selected]='row.uid === selectedUid',
                        (click)='select(row)',
                        (contextmenu)='showContextMenu(row, $event)'
                    )
                        td(
                            *ngFor='let cell of row.cells; let i = index',
                            [class.wide]='columns[i].wide',
                            [attr.data-tone]='cell.tone',
                            [title]='cell.text'
                        ) {{cell.text}}
            .text-muted.text-center.mt-3(*ngIf='!rows.length')
                span(*ngIf='totalCount', translate) Nothing matches the filter
                span(*ngIf='!totalCount', translate) There is nothing here

    .details(*ngIf='view === "resources" && selected')
        kube-details(
            [cluster]='cluster',
            [kind]='kind',
            [obj]='selected',
            (container)='onContainer($event)',
            (goToPod)='goToPod($event)',
            (action)='onAction(selected, $event)',
            (closed)='closeDetails()'
        )
